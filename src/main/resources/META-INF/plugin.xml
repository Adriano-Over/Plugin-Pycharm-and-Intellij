<idea-plugin>
    <id>com.floatbar</id>
    <name>Floatbar</name>
    <vendor email="support@example.com" url="https://example.com">Floatbar</vendor>

    <description><![CDATA[
        Floatbar drawing overlay plugin.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.floatbar.FloatingBarStartupActivity"/>

        <toolWindow
                id="Floatbar"
                anchor="right"
                factoryClass="com.floatbar.FloatingBarToolWindowFactory"
                canCloseContents="false"
                secondary="true"/>

        <statusBarWidgetFactory
                id="FloatBarStatusBarWidget"
                implementation="com.floatbar.FloatBarStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <action
                id="com.floatbar.ToggleFloatBar"
                class="com.floatbar.FloatBarToggleAction"
                text="Toggle FloatBar"
                description="Show or hide the FloatBar overlay">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
